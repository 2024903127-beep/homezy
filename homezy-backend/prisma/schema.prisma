// Homezy Ã¢â‚¬â€ Prisma schema (PostgreSQL)
// This is the single source of truth for the data model shared by the
// customer app, provider app, and admin panel. Field names/enums are kept
// in sync with:
//   - homezy-consumer/src/types/models.ts
//   - homezy-provider/src/types/models.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

