// Shared OTP table for both customer and provider phone verification.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  user       User?     @relation("UserOtps", fields: [userId], references: [id])
  userId     String?
  provider   Provider? @relation("ProviderOtps", fields: [providerId], references: [id])
  providerId String?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

