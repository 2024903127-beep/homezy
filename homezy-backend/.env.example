# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://homezy:homezy@localhost:5432/homezy?schema=public"

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# OTP / SMS (Twilio or any SMS gateway)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=HOMEZY

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Cloud Messaging (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 Object Storage
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=home-service-storage
R2_PUBLIC_DOMAIN=https://pub-a3be33960a904a3b9fa7b7a2617e8150.r2.dev

# Admin bootstrap (used by prisma/seed.ts to create the first admin user)
SEED_ADMIN_EMAIL=admin@homezy.example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
