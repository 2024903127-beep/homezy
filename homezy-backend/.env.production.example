# =============================================================================
# Homezy Production Environment Configuration Template
# =============================================================================
# Copy this file to .env on your production server:
# cp .env.production.example .env

# Node Environment & Server
NODE_ENV=production
PORT=4000

# CORS Whitelist (comma-separated list of allowed web origins)
CORS_ORIGINS="https://homezy.in,https://www.homezy.in,https://admin.homezy.in"

# Database (Production PostgreSQL Connection Pool)
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public&sslmode=require"

# JWT Security
# Generate a secure 64-char key with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=30d

# Brevo (Sendinblue) Transactional Email
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_NAME="Homezy"
BREVO_SENDER_EMAIL="notifications@homezy.in"

# SMS OTP Provider (MSG91 or Twilio)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# OR Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Razorpay Payments (Live Mode)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Cloud Messaging (Push Notifications for Mobile)
# Download Service Account JSON from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=homezy-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@homezy-production.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 Object Storage (KYC Documents, Profile Pictures, Invoices)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=homezy-prod-media
R2_PUBLIC_DOMAIN=https://media.homezy.in

# Initial Super Admin Account Seed (Used on first deployment, change after setup)
SEED_ADMIN_NAME="Super Administrator"
SEED_ADMIN_EMAIL=superadmin@homezy.in
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD
